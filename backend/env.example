# Django REST + DRF Starter Environment Configuration
# Copy this file to .env and update the values for your environment

# Environment (local, dev, uat, prod, demo)
# `demo` runs the identical app against a SEPARATE database (backend_demo) with
# DEMO_MODE on — the only environment where the demo seed is allowed to run.
DJANGO_ENV=dev

# Django settings
SECRET_KEY=your-secret-key-here-generate-a-new-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# For Docker development (default):
DATABASE_URL=postgresql://postgres:postgres@db:5432/backend_dev

# For local development without Docker, comment out DATABASE_URL and use these:
# DB_NAME=backend_local
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=localhost
# DB_PORT=5432

# For production, use a managed database:
# DATABASE_URL=postgresql://username:password@your-db-host:5432/your_production_db

# Demo environment database (used only when DJANGO_ENV=demo). MUST be a
# different database from DATABASE_URL so demo data can never mix with real data.
# DEMO_DATABASE_URL=postgresql://postgres:postgres@db:5432/backend_demo

# CORS settings (update with your frontend URLs)
# Cookie-based auth requires credentials, so CORS must allow them AND list the
# exact SPA origin(s) — wildcard origins are illegal with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=True

# JWT settings
SIMPLE_JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
SIMPLE_JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
SIMPLE_JWT_ROTATE_REFRESH_TOKENS=True
SIMPLE_JWT_BLACKLIST_AFTER_ROTATION=True
SIMPLE_JWT_UPDATE_LAST_LOGIN=True
SIMPLE_JWT_ALGORITHM=HS256

# JWT HttpOnly cookie settings
# The access/refresh JWTs are stored in HttpOnly cookies (not localStorage), so
# JavaScript can never read them.
# AUTH_COOKIE_SECURE: set True once served over HTTPS (browsers drop a Secure
#   cookie over plain HTTP — leave False on the current HTTP deployment).
# AUTH_COOKIE_SAMESITE: 'Lax' (default) blocks cross-site sends (CSRF defense) and
#   works for a same-site SPA. For a cross-site SPA use 'None' WITH Secure=True.
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_DOMAIN=            # leave unset unless sharing across subdomains
# AUTH_COOKIE_ACCESS_NAME=access_token
# AUTH_COOKIE_REFRESH_NAME=refresh_token

# Celery settings
# For Docker development (default):
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# For local development without Docker, use these:
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# For production, use external Redis:
# CELERY_BROKER_URL=redis://your-redis-host:6379/0
# CELERY_RESULT_BACKEND=redis://your-redis-host:6379/1

# Logging
DJANGO_LOG_LEVEL=DEBUG

# PostgreSQL Docker settings (only used by docker-compose)
POSTGRES_DB=backend_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional: Email settings (for password reset, notifications, etc.)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.your-provider.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@yourdomain.com
# EMAIL_HOST_PASSWORD=your-email-password
# DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Optional: Superuser creation (for initial setup)
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=your-admin-password

